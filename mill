#!/usr/bin/env bash
set -euo pipefail

# mill — run an AI agent (claude or codex) in a respawning loop, inside Docker.

# Resolve symlinks so `ln -s .../mill ~/.local/bin/mill` still finds the
# Dockerfile and prompts next to the real script.
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
    link="$(readlink "$self")"
    [[ "$link" == /* ]] || link="$(dirname "$self")/$link"
    self="$link"
done
MILL_DIR="$(cd "$(dirname "$self")" && pwd)"
unset self link
CONFIG_FILE="${AGENTMILL_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/agentmill/env}"
NET="agentmill"
DIND="agentmill-dind"
GITFILE_SNAPSHOT_DIR=""
GITFILE_SNAPSHOT_COUNT=0

cleanup_gitfile_snapshots() {
    [[ -n "$GITFILE_SNAPSHOT_DIR" ]] || return 0
    rm -rf -- "$GITFILE_SNAPSHOT_DIR"
    GITFILE_SNAPSHOT_DIR=""
}
trap cleanup_gitfile_snapshots EXIT

usage() {
    cat <<EOF
mill — AgentMill CLI

Usage:
  mill [-C DIR] run   [--agent claude|codex] [--model M] [--iterations N]
                      [--prompt FILE] [--dind] [-d|--detach]
  mill [-C DIR] shell [--dind]   Interactive shell inside the container
  mill [-C DIR] logs [--raw|--results]
                      Follow the running loop, else the last iteration
                      summaries; --raw tails the last event log, --results
                      prints results.jsonl as a table
  mill [-C DIR] stop             Stop this checkout's container
  mill [-C DIR] stop --soft      Ask the loop to finish the current iteration
  mill stop --all                Stop every agentmill container (and dind)
  mill [-C DIR] steer [TEXT|-]   One-shot instruction for the next session;
                                 no argument prints the pending one
  mill [-C DIR] init             Write a MILL.md template into the checkout
  mill ps | build

The checkout is the git repository containing the current directory (or DIR).
Its MILL.md holds the mission and per-repo settings; credentials and defaults
live in $CONFIG_FILE (see .env.example).
Precedence for supported/user-config keys: flags > environment > MILL.md > config file.
Parallel agents: one worktree per agent, run mill once per worktree —
  git worktree add ../repo-b agent-b && mill -C ../repo-b run -d
EOF
    exit "${1:-0}"
}

# The checkout is whichever git repository contains $REPO_START (cwd or -C):
# the same rule git, make, and cargo use, so `cd repo && mill run` just works.
resolve_repo() {
    local repo
    [[ -d "$REPO_START" ]] || { echo "Error: directory not found: $REPO_START" >&2; exit 1; }
    repo="$(git -C "$REPO_START" rev-parse --show-toplevel 2>/dev/null)" \
        || { echo "Error: $REPO_START is not inside a git repository (cd into one, or mill -C DIR)" >&2; exit 1; }
    # One physical checkout gets one identity even when the caller uses a
    # trailing slash, .. component, or symlink. Besides keeping the live-run
    # guard sound, preserving this path inside the container makes relative
    # submodule gitdir pointers resolve exactly as they do on the host.
    repo="$(cd -P -- "$repo" && pwd)"
    REPO_PATH="$repo"
    # Distinct containers/log dirs per checkout: two repos can share a basename,
    # and force-removing the other one's container would kill a live run.
    CONTAINER_NAME="agentmill-$(basename "$REPO_PATH" | tr -c 'a-zA-Z0-9_.-' '-' | sed 's/-$//')-$(path_hash "$REPO_PATH")"
    MISSION_FILE="$REPO_PATH/MILL.md"
}

require_mission() {
    [[ -f "$MISSION_FILE" ]] \
        || { echo "Error: no MILL.md in $REPO_PATH — run \`mill init\` and describe the mission" >&2; exit 1; }
    load_mission
}

path_hash() { printf '%s' "$1" | (shasum 2>/dev/null || cksum) | tr -cd 'a-f0-9' | cut -c1-6; }

# Validate one <common>/worktrees/<id>/gitdir record before treating its
# contents as a Docker bind source. That metadata is writable by the agent;
# without the reverse `.git -> this exact entry` check it could name an
# arbitrary existing host file and expose it in the next container.
VALIDATED_WORKTREE_GITFILE=""
VALIDATED_WORKTREE_DIR=""
VALIDATED_WORKTREE_POINTER=""
validate_worktree_gitdir_record() {
    local common="$1" entry="$2" worktrees_root entry_dir path path_parent
    local worktrees_physical entry_physical parent_physical pointer target target_physical
    VALIDATED_WORKTREE_GITFILE=""
    VALIDATED_WORKTREE_DIR=""
    VALIDATED_WORKTREE_POINTER=""
    [[ -f "$entry" && ! -L "$entry" ]] || return 1
    worktrees_root="$common/worktrees"
    [[ -d "$worktrees_root" && ! -L "$worktrees_root" ]] || return 1
    worktrees_physical="$(cd -P -- "$worktrees_root" 2>/dev/null && pwd)" || return 1
    entry_dir="${entry%/gitdir}"
    entry_physical="$(cd -P -- "$entry_dir" 2>/dev/null && pwd)" || return 1
    [[ "${entry_physical%/*}" == "$worktrees_physical" ]] || return 1

    path="$(cat -- "$entry")" || return 1
    [[ -n "$path" && "$path" != *$'\n'* && "$path" == /* ]] || return 1
    [[ "${path##*/}" == .git && -f "$path" && ! -L "$path" ]] || return 1
    path_parent="${path%/.git}"
    parent_physical="$(cd -P -- "$path_parent" 2>/dev/null && pwd)" || return 1

    pointer="$(cat -- "$path")" || return 1
    [[ -n "$pointer" && "$pointer" != *$'\n'* && "$pointer" == gitdir:* ]] || return 1
    target="${pointer#gitdir:}"
    target="${target#"${target%%[![:space:]]*}"}"
    [[ -n "$target" ]] || return 1
    [[ "$target" == /* ]] || target="$parent_physical/$target"
    target_physical="$(cd -P -- "$target" 2>/dev/null && pwd)" || return 1
    [[ "$target_physical" == "$entry_physical" ]] || return 1

    VALIDATED_WORKTREE_GITFILE="$path"
    VALIDATED_WORKTREE_DIR="$parent_physical"
    VALIDATED_WORKTREE_POINTER="$pointer"
}

SNAPSHOTTED_GITFILE=""
snapshot_validated_gitfile() {
    local snapshot copied
    SNAPSHOTTED_GITFILE=""
    if [[ -z "$GITFILE_SNAPSHOT_DIR" ]]; then
        GITFILE_SNAPSHOT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/agentmill-gitfiles.XXXXXX")" \
            || return 1
        chmod 700 "$GITFILE_SNAPSHOT_DIR" || return 1
    fi
    GITFILE_SNAPSHOT_COUNT=$((GITFILE_SNAPSHOT_COUNT + 1))
    snapshot="$GITFILE_SNAPSHOT_DIR/gitfile-$GITFILE_SNAPSHOT_COUNT"
    # -P snapshots a racing symlink as a symlink instead of dereferencing it;
    # the regular-file check below then fails closed. Docker sees only this
    # private immutable copy, never the worker-mutable host pathname.
    /bin/cp -P "$VALIDATED_WORKTREE_GITFILE" "$snapshot" 2>/dev/null \
        || return 1
    [[ -f "$snapshot" && ! -L "$snapshot" ]] || return 1
    copied="$(cat -- "$snapshot")" || return 1
    [[ "$copied" == "$VALIDATED_WORKTREE_POINTER" ]] || return 1
    chmod 400 "$snapshot" || return 1
    SNAPSHOTTED_GITFILE="$snapshot"
}

# A linked worktree's .git is a file pointing at <main repo>/.git/worktrees/<name>;
# that exact path must exist inside the container too, or git fails on the first
# command. The main checkout has a .git directory instead, but still needs every
# linked sibling's .git file mounted so a prune inside the container cannot
# mistake that sibling for a missing checkout.
worktree_mount() {
    local gitdir common entry path gitdir_physical active_gitfile_snapshot=""
    if [[ -f "$REPO_PATH/.git" ]]; then
        [[ ! -L "$REPO_PATH/.git" ]] \
            || { echo "Error: linked-worktree .git may not be a symlink" >&2; exit 1; }
        gitdir="$(sed -n 's/^gitdir: *//p' "$REPO_PATH/.git")"
        [[ -n "$gitdir" ]] || { echo "Error: $REPO_PATH/.git has no gitdir: pointer" >&2; exit 1; }
        [[ "$gitdir" != *$'\n'* ]] \
            || { echo "Error: $REPO_PATH/.git has multiple gitdir pointers" >&2; exit 1; }
        [[ "$gitdir" == /* ]] || {
            echo "Error: $REPO_PATH records a relative gitdir ($gitdir), which cannot be" >&2
            echo "       mapped into the container. Recreate the worktree with absolute paths." >&2
            exit 1
        }
        [[ "$gitdir" == */worktrees/* && -d "$gitdir" && ! -L "$gitdir" ]] \
            || { echo "Error: malformed linked-worktree gitdir: $gitdir" >&2; exit 1; }
        gitdir_physical="$(cd -P -- "$gitdir" 2>/dev/null && pwd)" \
            || { echo "Error: linked-worktree gitdir not found: $gitdir" >&2; exit 1; }
        [[ "$gitdir_physical" == "$gitdir" ]] \
            || { echo "Error: linked-worktree gitdir must use a canonical path" >&2; exit 1; }
        common="${gitdir%/worktrees/*}"      # the main repo's git dir
        [[ -d "$common" && ! -L "$common" ]] \
            || { echo "Error: common git dir $common is not a regular directory" >&2; exit 1; }
        if ! validate_worktree_gitdir_record "$common" "$gitdir/gitdir" \
            || [[ "$VALIDATED_WORKTREE_DIR" != "$REPO_PATH" ]]; then
            echo "Error: linked-worktree metadata does not round-trip to $REPO_PATH/.git" >&2
            exit 1
        fi
        snapshot_validated_gitfile \
            || { echo "Error: linked-worktree .git changed while it was validated" >&2; exit 1; }
        active_gitfile_snapshot="$SNAPSHOTTED_GITFILE"
    elif [[ -d "$REPO_PATH/.git" ]]; then
        [[ ! -L "$REPO_PATH/.git" ]] \
            || { echo "Error: main-checkout .git may not be a symlink" >&2; exit 1; }
        common="$REPO_PATH/.git"
    else
        echo "Error: no git metadata found for $REPO_PATH" >&2
        exit 1
    fi
    [[ -d "$common" ]] || { echo "Error: git dir $common not found for worktree $REPO_PATH" >&2; exit 1; }
    # Pin the common directory as its own bind mount even for a main checkout.
    # Besides exposing an out-of-tree common dir for linked checkouts, the
    # nested main-checkout mount makes the validated .git directory a mount
    # point: a parallel worker cannot rename/symlink-swap it while Docker is
    # resolving a later container's bind sources.
    RUN_ARGS+=(-v "$common:$common")
    # Never rely on its writable common-dir record to rediscover the active
    # linked checkout's pointer file.
    [[ -z "$active_gitfile_snapshot" ]] \
        || RUN_ARGS+=(-v "$active_gitfile_snapshot:$REPO_PATH/.git:ro")
    # Each worktrees/<name>/gitdir records the host path of that checkout's
    # .git file. `git worktree prune` (also run by gc) deletes any entry whose
    # path does not exist — inside the container none of them would, so one
    # prune would wreck this worktree and every sibling's on the host. Make
    # every recorded path resolve by mounting the .git file itself, read-only.
    for entry in "$common"/worktrees/*/gitdir; do
        [[ -e "$entry" || -L "$entry" ]] || continue
        if ! validate_worktree_gitdir_record "$common" "$entry"; then
            echo "Warning: ignoring malformed worktree metadata: $entry" >&2
            continue
        fi
        path="$VALIDATED_WORKTREE_GITFILE"
        [[ "$path" != "$REPO_PATH/.git" ]] || continue
        if ! snapshot_validated_gitfile; then
            echo "Warning: ignoring worktree .git changed during validation: $path" >&2
            continue
        fi
        RUN_ARGS+=(-v "$SNAPSHOTTED_GITFILE:$path:ro")
    done
}

# Config the container understands. Keys found in the config file or MILL.md
# frontmatter are appended, so a custom var set there reaches the agent too.
ENV_KEYS=(ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN OPENAI_API_KEY
          HTTP_PROXY HTTPS_PROXY NO_PROXY NODE_EXTRA_CA_CERTS
          http_proxy https_proxy no_proxy
          AGENT MODEL FALLBACK_MODEL MAX_ITERATIONS MAX_ERRORS MAX_NOOPS
          ITER_TIMEOUT LOOP_DELAY ERROR_BACKOFF MAX_BACKOFF SHUTDOWN_GRACE
          MAX_TURNS MIN_TURNS MAX_BUDGET_USD MAX_TOTAL_BUDGET_USD
          DONE_PROMISE SETUP_CMD CHECK_CMD METRIC_CMD METRIC_DIRECTION
          DONE_CMD EVALUATOR CLAUDE_BARE
          GIT_USER GIT_EMAIL)
ENV_FILE_KEYS=() ENV_FILE_VALS=()   # parallel arrays: bash 3 has no assoc arrays
MISSION_KEYS=() MISSION_VALS=()     # MILL.md frontmatter, uppercased
FORWARD_FILE_KEYS=() FORWARD_FILE_VALS=() # private --env-file, never host env
CALLER_ENV_KEYS=()                  # fixed keys + names trusted by user config
ENV_FILE_INSERT_AT=0

# Resolved config value: environment > MILL.md frontmatter > config file for
# fixed keys and names explicitly trusted in the user config. Repository-only
# names deliberately cannot select unrelated values from the caller environment.
caller_env_allowed() {
    local allowed
    for allowed in "${CALLER_ENV_KEYS[@]}"; do
        [[ "$allowed" == "$1" ]] && return 0
    done
    return 1
}

cfg() {
    local i
    if caller_env_allowed "$1" && [[ -n "${!1:-}" ]]; then
        printf '%s' "${!1}"
        return
    fi
    for i in ${MISSION_KEYS[@]+"${!MISSION_KEYS[@]}"}; do
        [[ "${MISSION_KEYS[$i]}" == "$1" && -n "${MISSION_VALS[$i]}" ]] \
            && { printf '%s' "${MISSION_VALS[$i]}"; return 0; }
    done
    for i in ${ENV_FILE_KEYS[@]+"${!ENV_FILE_KEYS[@]}"}; do
        [[ "${ENV_FILE_KEYS[$i]}" == "$1" ]] && { printf '%s' "${ENV_FILE_VALS[$i]}"; return 0; }
    done
    return 0
}

remember_key() {  # make a file-provided key reach the container
    local k
    case "$1" in
        PATH|HOME|REPO_DIR|LOG_DIR|PROMPT_FILE|EVALUATOR_FILE|MISSION_FILE|AGENTMILL_IMAGE|AGENTMILL_CONFIG|AGENTMILL_LOG_REPO_REL|DIND_READY_TIMEOUT)
            return 0 ;; # mill-only / host-managed
        BASH_ENV|ENV|LD_*|DYLD_*|GCONV_PATH|LOCPATH|NLSPATH|TAR_OPTIONS)
            echo "Warning: ignoring unsafe container environment key: $1" >&2
            return 0 ;; # can execute before loop.sh establishes its boundary
    esac
    for k in "${ENV_KEYS[@]}"; do [[ "$k" == "$1" ]] && return 0; done
    ENV_KEYS+=("$1")
}

# MILL.md may open with a YAML-ish frontmatter block of `key: value` lines
# (lowercase env var names; quotes optional). The body is the mission and is
# read by loop.sh inside the container; only the settings are parsed here.
load_mission() {
    local line key val i closed=false
    local parsed_keys=() parsed_vals=()
    IFS= read -r line < "$MISSION_FILE" || true
    line="${line%$'\r'}"
    [[ "$line" == "---" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        if [[ "$line" == "---" ]]; then
            closed=true
            break
        fi
        [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*:(.*)$ ]] || continue
        key="$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')" val="${BASH_REMATCH[2]}"
        val="${val#"${val%%[![:space:]]*}"}"
        if [[ "$val" =~ ^\"(([^\"\\]|\\.)*)\"[[:space:]]*(#.*)?$ ]]; then
            val="${BASH_REMATCH[1]}"; val="${val//\\\"/\"}"; val="${val//\\\\/\\}"
        elif [[ "$val" =~ ^\'([^\']*)\'[[:space:]]*(#.*)?$ ]]; then
            val="${BASH_REMATCH[1]}"
        else
            [[ "$val" == \#* ]] && val=""
            val="${val%%[[:space:]]#*}"
            val="${val%"${val##*[![:space:]]}"}"
        fi
        parsed_keys+=("$key") parsed_vals+=("$val")
    done < <(tail -n +2 "$MISSION_FILE")
    [[ "$closed" == true ]] || {
        echo "Error: unclosed frontmatter in $MISSION_FILE (missing closing ---)" >&2
        exit 1
    }
    # Do not expose any setting until the whole block has been validated. This
    # keeps mission-body lines from becoming config when the closing fence is
    # missing.
    for i in ${parsed_keys[@]+"${!parsed_keys[@]}"}; do
        MISSION_KEYS+=("${parsed_keys[$i]}") MISSION_VALS+=("${parsed_vals[$i]}")
        remember_key "${parsed_keys[$i]}"
    done
}

# The config file is KEY=value. Values may be "double" or 'single' quoted;
# unquoted values end at an inline ` # comment` and lose surrounding
# whitespace. Parsed into ENV_FILE_* rather than sourced: a PATH= or
# DOCKER_HOST= line must not redirect mill's own commands. Resolved file values
# are forwarded later through a private Docker --env-file.
load_env() {
    local file="$CONFIG_FILE" line key val
    if [[ ! -f "$file" && -f "$MILL_DIR/.env" ]]; then
        file="$MILL_DIR/.env"
        echo "mill: reading $file — move it to $CONFIG_FILE" >&2
    fi
    [[ -f "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do   # || : last line may lack a newline
        [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=(.*)$ ]] || continue
        key="${BASH_REMATCH[2]}" val="${BASH_REMATCH[3]}"
        val="${val#"${val%%[![:space:]]*}"}"                       # ltrim
        if [[ "$val" =~ ^\"(([^\"\\]|\\.)*)\"[[:space:]]*(#.*)?$ ]]; then
            val="${BASH_REMATCH[1]}"; val="${val//\\\"/\"}"; val="${val//\\\\/\\}"
        elif [[ "$val" =~ ^\'([^\']*)\'[[:space:]]*(#.*)?$ ]]; then
            val="${BASH_REMATCH[1]}"
        else
            [[ "$val" == \#* ]] && val=""
            val="${val%%[[:space:]]#*}"                            # inline comment
            val="${val%"${val##*[![:space:]]}"}"                   # rtrim
        fi
        ENV_FILE_KEYS+=("$key") ENV_FILE_VALS+=("$val")
        remember_key "$key"
    done < "$file"
}

# DinD sidecar for repos whose work needs docker (testcontainers, image
# builds). Privileged, but the blast radius is the sidecar — never the host
# docker socket.
ensure_dind() {
    local ready_timeout elapsed=0
    docker network inspect "$NET" >/dev/null 2>&1 || docker network create "$NET" >/dev/null
    if docker container inspect "$DIND" >/dev/null 2>&1; then
        # Normally redundant because the sidecar uses --rm, but it also
        # recovers an old stopped container created by an earlier version.
        docker start "$DIND" >/dev/null 2>&1 || true
    else
        echo "Starting dind sidecar..."
        docker run -d --rm --name "$DIND" --label agentmill --label agentmill.dind --privileged \
            --network "$NET" -e DOCKER_TLS_CERTDIR= docker:27-dind >/dev/null
    fi

    ready_timeout="$(cfg DIND_READY_TIMEOUT)"
    ready_timeout="${ready_timeout:-30}"
    [[ "$ready_timeout" != *[!0-9]* ]] \
        || { echo "Error: DIND_READY_TIMEOUT must be a non-negative integer" >&2; exit 1; }
    # Probe the same plaintext TCP listener used by the agent containers, not
    # only dockerd's local Unix socket inside the sidecar.
    until docker exec "$DIND" docker -H tcp://127.0.0.1:2375 info >/dev/null 2>&1; do
        if [[ "$elapsed" -ge "$ready_timeout" ]]; then
            echo "Error: dind did not become ready within ${ready_timeout}s" >&2
            exit 1
        fi
        [[ "$elapsed" -gt 0 ]] || echo "Waiting for dind to accept connections..."
        sleep 1
        elapsed=$((elapsed + 1))
    done
    DIND_ARGS=(--network "$NET" -e "DOCKER_HOST=tcp://$DIND:2375")
}

common_args() {  # fills RUN_ARGS with env + mounts shared by run/shell
    # The stop timeout is resolved here, where the repo's MILL.md is loaded,
    # and recorded on the container so `mill stop` (and --all) can honor each
    # container's own shutdown_grace without re-deriving config.
    RUN_ARGS=(--label agentmill --label "agentmill.stop-timeout=$(container_stop_timeout)"
              --init --memory 4g --pids-limit 512)
    # Caller-provided values already live in Docker's environment, so bare
    # -e KEY preserves them (including values an env file cannot represent).
    # File/frontmatter values may be arbitrary secrets or host-sensitive names
    # such as DOCKER_HOST. Stage those for a private --env-file:
    # neither their names nor values enter the host Docker client's environment.
    local key val
    FORWARD_FILE_KEYS=() FORWARD_FILE_VALS=()
    for key in "${ENV_KEYS[@]}"; do
        val="$(cfg "$key")"
        [[ -n "$val" ]] || continue
        if caller_env_allowed "$key" && [[ -n "${!key:-}" ]]; then
            RUN_ARGS+=(-e "$key")
        else
            FORWARD_FILE_KEYS+=("$key") FORWARD_FILE_VALS+=("$val")
        fi
    done
    # Remember this position before mounts and the flag-/DinD-provided -e
    # options appended by cmd_run. Inserting the env file here preserves
    # Docker's normal last-value-wins precedence without an argv sentinel.
    ENV_FILE_INSERT_AT=${#RUN_ARGS[@]}
    LOG_DIR_HOST="$MILL_DIR/logs/$CONTAINER_NAME"   # per checkout: parallel runs must not interleave
    mkdir -p "$LOG_DIR_HOST" "$MILL_DIR/prompts"
    # The operator drop-box (STOP / STEER.md) rides in the bind-mounted
    # checkout; loop.sh adds it to the repo's exclude file on startup.
    mkdir -p "$REPO_PATH/.mill"
    RUN_ARGS+=(
        -e "REPO_DIR=$REPO_PATH"
        -v "$REPO_PATH:$REPO_PATH"
        -v "$LOG_DIR_HOST:/workspace/logs"
        -v "$MILL_DIR/prompts:/prompts:ro"
    )
    [[ "$LOG_DIR_HOST" != "$REPO_PATH/"* ]] \
        || RUN_ARGS+=(-e "AGENTMILL_LOG_REPO_REL=${LOG_DIR_HOST#"$REPO_PATH/"}")
    worktree_mount
}

docker_with_env_file() {
    local insert_at="$1" i arg env_file docker_pid="" docker_rc=0 signal_rc=0
    local signal_name="" docker_launching=false
    local position=0 docker_args=()
    shift
    if [[ ${#FORWARD_FILE_KEYS[@]} -eq 0 ]]; then
        docker "$@"
        return
    fi
    (
        # mktemp creates the file atomically; chmod makes the privacy contract
        # explicit across implementations. EXIT cleanup covers success, Docker
        # failure, interactive exit, detach completion, and signals.
        env_file="$(mktemp "${TMPDIR:-/tmp}/agentmill-env.XXXXXX")"
        # shellcheck disable=SC2329 # invoked through EXIT below
        cleanup_env_file() { rm -f -- "$env_file"; }
        # shellcheck disable=SC2329 # invoked through HUP/INT/TERM traps below
        forward_docker_signal() {
            local signal="$1" status="$2"
            signal_name="$signal" signal_rc="$status"
            # Remove secrets immediately; Bash otherwise defers an EXIT trap
            # while a foreground Docker client is still handling the signal.
            cleanup_env_file
            if [[ -n "$docker_pid" ]]; then
                kill "-$signal" "$docker_pid" 2>/dev/null || true
            elif [[ "$docker_launching" == false ]]; then
                exit "$status"
            fi
        }
        trap cleanup_env_file EXIT
        trap 'forward_docker_signal HUP 129' HUP
        trap 'forward_docker_signal INT 130' INT
        trap 'forward_docker_signal TERM 143' TERM
        chmod 600 "$env_file"
        for i in ${FORWARD_FILE_KEYS[@]+"${!FORWARD_FILE_KEYS[@]}"}; do
            printf '%s=%s\n' "${FORWARD_FILE_KEYS[$i]}" "${FORWARD_FILE_VALS[$i]}" >> "$env_file"
        done
        for arg in "$@"; do
            if [[ "$position" -eq "$insert_at" ]]; then
                docker_args+=(--env-file "$env_file")
            fi
            docker_args+=("$arg")
            position=$((position + 1))
        done
        [[ "$position" -ne "$insert_at" ]] || docker_args+=(--env-file "$env_file")
        # Explicit stdin keeps `mill shell` interactive even though the client
        # is backgrounded so Bash can run the signal traps immediately.
        docker_launching=true
        docker "${docker_args[@]}" <&0 &
        docker_pid=$!
        docker_launching=false
        [[ "$signal_rc" -eq 0 ]] \
            || kill "-$signal_name" "$docker_pid" 2>/dev/null || true
        until wait "$docker_pid"; do
            docker_rc=$?
            kill -0 "$docker_pid" 2>/dev/null || break
            docker_rc=0
        done
        [[ "$signal_rc" -eq 0 ]] || docker_rc="$signal_rc"
        exit "$docker_rc"
    )
}

cmd_run() {
    local agent="" model="" iterations="" prompt="" detach=false dind=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)     usage 0 ;;
            --agent)       agent="$2"; shift 2 ;;
            --model)       model="$2"; shift 2 ;;
            --iterations)  iterations="$2"; shift 2 ;;
            --prompt)      prompt="$2"; shift 2 ;;
            --dind)        dind=true; shift ;;
            -d|--detach)   detach=true; shift ;;
            *) echo "Error: unknown option: $1 (the checkout is the cwd; use mill -C DIR)" >&2; usage 1 ;;
        esac
    done
    resolve_repo
    require_mission
    if [[ "$dind" == true && "$(cfg EVALUATOR)" == true ]]; then
        echo "Error: EVALUATOR=true cannot be combined with --dind; the reviewer must not share a privileged Docker API" >&2
        exit 1
    fi

    common_args
    [[ -n "$agent" ]]      && RUN_ARGS+=(-e "AGENT=$agent")
    [[ -n "$model" ]]      && RUN_ARGS+=(-e "MODEL=$model")
    [[ -n "$iterations" ]] && RUN_ARGS+=(-e "MAX_ITERATIONS=$iterations")
    if [[ -n "$prompt" ]]; then
        [[ "$prompt" == /* ]] || prompt="$PWD/$prompt"
        [[ -f "$prompt" ]] || { echo "Error: prompt file not found: $prompt" >&2; exit 1; }
        RUN_ARGS+=(-v "$prompt:/prompts/PROMPT.md:ro")
    fi
    [[ "$dind" == true ]] && { ensure_dind; RUN_ARGS+=("${DIND_ARGS[@]}"); }
    [[ "$detach" == true ]] && RUN_ARGS+=(-d)

    if docker ps -q --filter "name=^/${CONTAINER_NAME}$" | grep -q .; then
        echo "Error: $CONTAINER_NAME is already running for $REPO_PATH (mill stop, or wait)" >&2
        exit 1
    fi
    docker rm "$CONTAINER_NAME" >/dev/null 2>&1 || true
    docker_with_env_file "$((4 + ENV_FILE_INSERT_AT))" \
        run --rm --name "$CONTAINER_NAME" "${RUN_ARGS[@]}" "$IMAGE"
}

cmd_shell() {
    local dind=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) usage 0 ;;
            --dind) dind=true; shift ;;
            *) echo "Error: unknown option: $1 (the checkout is the cwd; use mill -C DIR)" >&2; usage 1 ;;
        esac
    done
    resolve_repo
    [[ -f "$MISSION_FILE" ]] && load_mission   # shell works without a mission
    common_args
    [[ "$dind" == true ]] && { ensure_dind; RUN_ARGS+=("${DIND_ARGS[@]}"); }
    docker_with_env_file "$((5 + ENV_FILE_INSERT_AT))" \
        run --rm -it --entrypoint bash "${RUN_ARGS[@]}" -w "$REPO_PATH" "$IMAGE"
}

# Newest-last list of a checkout's log files matching $1. Collected into an
# array first: with no matches, `xargs ls -t` would list the cwd instead.
collect_logs() {
    local f files=()
    LOG_FILES=()
    while IFS= read -r f; do files+=("$f"); done < <(
        find "$MILL_DIR/logs/$CONTAINER_NAME" -maxdepth 1 -name "$1" \
            ! -name '*.eval.*' 2>/dev/null)
    [[ ${#files[@]} -gt 0 ]] || return 1
    # shellcheck disable=SC2012  # names are generated by loop.sh, no spaces
    while IFS= read -r f; do LOG_FILES+=("$f"); done < <(ls -tr "${files[@]}")
}

# The loop's per-iteration digest is the useful view; --raw is the full event
# stream, --results the machine-readable ledger.
cmd_logs() {
    local mode=summary
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) usage 0 ;;
            --raw)     mode=raw; shift ;;
            --results) mode=results; shift ;;
            *) echo "Error: unknown option: $1 (the checkout is the cwd; use mill -C DIR)" >&2; usage 1 ;;
        esac
    done
    resolve_repo
    local results="$MILL_DIR/logs/$CONTAINER_NAME/results.jsonl"
    if [[ "$mode" == results ]]; then
        [[ -f "$results" ]] || { echo "No results for $REPO_PATH." >&2; exit 1; }
        command -v jq >/dev/null || { echo "Error: jq is required for --results" >&2; exit 1; }
        printf '%-5s %-9s %-8s %-9s %-6s %s\n' ITER STATUS COMMITS COST TURNS TIME
        jq -r 'def pad(n): (. + "          ")[0:n];
               [ ((.iter // 0) | tostring | pad(5)), ((.status // "?") | pad(9)),
                 ((.commits // 0) | tostring | pad(8)),
                 (("$" + (((.cost_usd // 0) * 100 | round / 100) | tostring)) | pad(9)),
                 ((.turns // "?") | tostring | pad(6)),
                 (((.duration_s // 0) | tostring) + "s") ] | join(" ")' "$results"
        return 0
    fi
    if [[ "$mode" == summary ]] \
        && docker ps -q --filter "name=^/${CONTAINER_NAME}$" | grep -q .; then
        docker logs -f "$CONTAINER_NAME"
        return 0
    fi
    local f n
    if [[ "$mode" == summary ]] && collect_logs 'iter-*.summary'; then
        n=${#LOG_FILES[@]}
        for f in "${LOG_FILES[@]:$((n > 3 ? n - 3 : 0))}"; do
            echo "=== $(basename "$f") ==="
            cat "$f"
        done
        return 0
    fi
    collect_logs 'iter-*.log' \
        || { echo "No running container and no logs for $REPO_PATH." >&2; exit 1; }
    local latest="${LOG_FILES[$((${#LOG_FILES[@]} - 1))]}"
    echo "=== $(basename "$latest") ==="
    tail -f "$latest"
}

cmd_ps()    { docker ps --filter label=agentmill; }

# The container user must own the bind-mounted repo and logs. Docker Desktop
# maps ownership for you; on a Linux host the uids have to match for real.
cmd_build() {
    local args=()
    [[ "$(uname -s)" == Linux ]] && args=(--build-arg "AGENT_UID=$(id -u)" --build-arg "AGENT_GID=$(id -g)")
    docker build ${args[@]+"${args[@]}"} -t "$IMAGE" "$MILL_DIR"
}

# Give loop.sh enough time to enforce its own agent SIGKILL deadline and then
# run its bounded cleanup of uncommitted bind-mounted checkout residue.
container_stop_timeout() {
    local grace
    grace="$(cfg SHUTDOWN_GRACE)"
    grace="${grace:-30}"
    [[ "$grace" != *[!0-9]* ]] \
        || { echo "Error: SHUTDOWN_GRACE must be a non-negative integer" >&2; return 1; }
    printf '%d' "$((10#$grace + 30))"
}

stop_container() {
    local target="$1" stop_timeout
    # The timeout was recorded as a label when the container started, so each
    # container gets the grace its own repo configured. Containers without
    # the label (older runs, the dind sidecar) fall back to env/config.
    stop_timeout="$(docker inspect \
        -f '{{index .Config.Labels "agentmill.stop-timeout"}}' "$target" \
        2>/dev/null || true)"
    [[ -n "$stop_timeout" && "$stop_timeout" != *[!0-9]* ]] \
        || stop_timeout="$(container_stop_timeout)" || stop_timeout=60
    # `docker stop` is synchronous and bounded: TERM first, KILL only after
    # the loop's cleanup window. With --rm the following remove is normally a
    # no-op; it only clears an already-stopped container left by an older run.
    docker stop --time "$stop_timeout" "$target" >/dev/null 2>&1 || true
    docker rm "$target" >/dev/null 2>&1 || true
}

running_agent_exists() {
    local id dind_id
    dind_id="$(docker ps -q --filter "name=^/${DIND}$" | head -1)"
    while IFS= read -r id; do
        [[ -n "$id" && "$id" != "$dind_id" ]] && return 0
    done < <(docker ps -q --filter label=agentmill)
    return 1
}

# Default: stop this checkout only, so parallel worktree runs survive each
# other's stops. The shared dind sidecar and network go when the last agent
# container is gone. --all: stop agents first, then dind.
# The soft brake: a file the running loop notices between iterations, so the
# agent's session is never cut off mid-work. No docker involved.
cmd_stop_soft() {
    resolve_repo
    mkdir -p "$REPO_PATH/.mill"
    : > "$REPO_PATH/.mill/STOP"
    echo "Will stop after the current iteration."
}

cmd_stop() {
    local id dind_id all=false
    case "${1:-}" in
        "") ;;
        -a|--all) all=true ;;
        -s|--soft) cmd_stop_soft; return 0 ;;
        *) echo "Error: unknown option: $1 (mill stop stops the cwd's checkout; --all stops everything)" >&2; usage 1 ;;
    esac
    if [[ "$all" == false ]]; then
        resolve_repo
        stop_container "$CONTAINER_NAME"
        if running_agent_exists; then
            echo "Stopped $CONTAINER_NAME."
            return 0
        fi
        stop_container "$DIND"
        docker network rm "$NET" >/dev/null 2>&1 || true
        echo "Stopped."
        return 0
    fi

    dind_id="$(docker ps -aq --filter "name=^/${DIND}$" | head -1)"
    while IFS= read -r id; do
        [[ -n "$id" && "$id" != "$dind_id" ]] || continue
        stop_container "$id"
    done < <(docker ps -aq --filter label=agentmill)
    stop_container "$DIND"
    docker network rm "$NET" >/dev/null 2>&1 || true
    echo "Stopped."
}

# One-shot steering: the next session gets this text in its preamble, and the
# loop deletes the file as it reads it. `-` takes the note from stdin.
cmd_steer() {
    [[ "${1:-}" != -h && "${1:-}" != --help ]] || usage 0
    resolve_repo
    local steer="$REPO_PATH/.mill/STEER.md"
    if [[ $# -eq 0 ]]; then
        [[ -s "$steer" ]] || { echo "No pending steer."; return 0; }
        cat "$steer"
        return 0
    fi
    mkdir -p "$REPO_PATH/.mill"
    if [[ "$1" == - ]]; then
        cat > "$steer"
    else
        printf '%s\n' "$*" > "$steer"
    fi
    echo "Steer queued for the next session of $REPO_PATH."
}

cmd_init() {
    resolve_repo
    if [[ ! -f "$CONFIG_FILE" ]]; then
        mkdir -p "$(dirname "$CONFIG_FILE")"
        cp "$MILL_DIR/.env.example" "$CONFIG_FILE"
        chmod 600 "$CONFIG_FILE"
        echo "Created $CONFIG_FILE — set your auth key."
    fi
    if [[ -f "$MISSION_FILE" ]]; then
        echo "$MISSION_FILE already exists."
        return 0
    fi
    cat > "$MISSION_FILE" <<'EOF'
---
# Per-repo settings, lowercase env var names (see .env.example for the list).
# Secrets do not belong here — this file is meant to be committed.
agent: claude
model:
check_cmd:            # ratchet: an iteration that fails this is reverted
setup_cmd:            # runs once before the loop (uv sync, npm ci, ...)
# done_cmd:           # must pass before a "done" claim stops the loop
# max_total_budget_usd:   # stop once the run has spent this much
# evaluator: true     # one isolated reviewer session must PASS a done claim
# metric_cmd:         # prints a score; only a strict improvement is kept
# metric_direction: min   # min | max — which way is better
---
# Mission

Describe what the agent should build or fix, in the level of detail you
would give a new teammate. Link the relevant files.

## Definition of done

- [ ] The verifier below is green.
- [ ] ...

## Verifier

```bash
# the command the agent runs to know it is done
```
EOF
    echo "Created $MISSION_FILE — describe the mission, then \`mill run\`."
}

REPO_START="$PWD"
while [[ $# -gt 0 ]]; do
    case "$1" in
        -C) [[ $# -ge 2 ]] || { echo "Error: -C needs a directory" >&2; usage 1; }
            REPO_START="$2"; shift 2 ;;
        -C*) REPO_START="${1#-C}"; shift ;;
        *) break ;;
    esac
done
[[ "$REPO_START" == /* ]] || REPO_START="$PWD/$REPO_START"
load_env
# Freeze caller-environment eligibility before repository frontmatter is read.
# Fixed supported keys and names explicitly present in the user config retain
# normal environment precedence; a repository cannot select an unrelated host
# secret merely by naming that variable in MILL.md.
CALLER_ENV_KEYS=("${ENV_KEYS[@]}" AGENTMILL_IMAGE DIND_READY_TIMEOUT)
IMAGE="$(cfg AGENTMILL_IMAGE)"; IMAGE="${IMAGE:-agentmill}"
case "${1:-}" in
    run)    shift; cmd_run "$@" ;;
    shell)  shift; cmd_shell "$@" ;;
    logs)   shift; cmd_logs "$@" ;;
    ps)     shift; cmd_ps "$@" ;;
    build)  shift; cmd_build "$@" ;;
    stop)   shift; cmd_stop "$@" ;;
    steer)  shift; cmd_steer "$@" ;;
    init)   shift; cmd_init "$@" ;;
    -h|--help|help|"") usage 0 ;;
    *) echo "Unknown command: $1" >&2; usage 1 ;;
esac
