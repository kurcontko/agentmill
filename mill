#!/usr/bin/env bash
set -euo pipefail

# Find the installation even when mill is symlinked into a directory on PATH.
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
    link="$(readlink "$self")"
    [[ "$link" == /* ]] || link="$(dirname "$self")/$link"
    self="$link"
done
MILL_DIR="$(cd "$(dirname "$self")" && pwd)"
unset self link

usage() {
    cat <<'EOF'
mill — a checked Claude loop in Docker

Usage:
  mill build [--platform PLAT]      Build the image
  mill init [repo]                  Create a MILL.md mission
  mill run [repo] --check CMD [--iterations N] [--timeout S] [--model M]
  mill legacy COMMAND              Access the old Compose runtime

Set ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN in your environment or .env.
Repo defaults to REPO_PATH, then the current directory.
Run defaults: 5 sessions, 1800 seconds per setup/session/check.
EOF
    exit "${1:-0}"
}

# Parse .env file if it exists (handles KEY=value, KEY="value", KEY='value')
load_env() {
    [[ -f "$MILL_DIR/.env" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%\#*}"                         # strip comments
        [[ "$line" =~ ^[[:space:]]*$ ]] && continue # skip blank lines
        [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
        local key="${BASH_REMATCH[1]}" val="${BASH_REMATCH[2]}"
        val="${val#\"}" val="${val%\"}"              # strip double quotes
        val="${val#\'}" val="${val%\'}"              # strip single quotes
        val="${val%"${val##*[! ]}"}"                 # trim trailing spaces
        [[ -z "${!key:-}" ]] && export "$key=$val"
    done < "$MILL_DIR/.env"
    return 0
}

cmd_run() {
    local repo="${REPO_PATH:-$PWD}" iterations=5 timeout=1800 model="${MODEL:-}"
    local check="${CHECK_CMD:-}" run_dir state_root status
    [[ $# -gt 0 && "${1:0:1}" != "-" ]] && { repo="$1"; shift; }
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) usage 0 ;;
            --check|--iterations|--timeout|--model)
                [[ $# -ge 2 && -n "$2" ]] || { echo "Missing value for $1" >&2; return 1; }
                case "$1" in
                    --check) check="$2" ;;
                    --iterations) iterations="$2" ;;
                    --timeout) timeout="$2" ;;
                    --model) model="$2" ;;
                esac
                shift 2 ;;
            *) echo "Unknown run argument: $1" >&2; return 1 ;;
        esac
    done
    [[ "$iterations" =~ ^[1-9][0-9]{0,5}$ && "$timeout" =~ ^[1-9][0-9]{0,5}$ ]] || {
        echo "Iterations and timeout must be positive integers (at most six digits)." >&2; return 1;
    }
    [[ -n "$check" ]] || { echo "Runs require --check CMD or CHECK_CMD." >&2; return 1; }
    repo="$(cd "$repo" && pwd -P)" || return 1
    [[ -d "$repo/.git" && ! -L "$repo/.git" ]] || {
        echo "Runs need a regular git checkout (no linked worktrees)." >&2; return 1;
    }
    [[ -f "$repo/MILL.md" ]] || {
        printf 'Missing MILL.md. Create a mission with: mill init %q\n' "$repo" >&2; return 1;
    }
    status="$(git -C "$repo" status --porcelain --untracked-files=all)" || return 1
    [[ -z "$status" ]] || {
        echo "Commit or stash your changes before starting a run." >&2; return 1;
    }
    [[ "$(id -u)" != 0 ]] || { echo "Run mill as a non-root user." >&2; return 1; }
    state_root="${XDG_STATE_HOME:-$HOME/.local/state}/agentmill/runs"
    mkdir -p "$state_root"
    state_root="$(cd "$state_root" && pwd -P)"
    [[ "$state_root" != "$repo" && "$state_root" != "$repo/"* ]] || {
        echo "XDG_STATE_HOME must put run logs outside the checkout." >&2; return 1;
    }
    # Docker --mount uses commas as delimiters; reject ambiguous source paths.
    [[ "$repo$state_root" != *,* ]] || { echo "Mount paths cannot contain commas." >&2; return 1; }
    run_dir="$(mktemp -d "$state_root/run-XXXXXXXX")"
    printf 'Run: %s\nLogs: %s\n' "${run_dir##*/}" "$run_dir"
    export CHECK_CMD="$check"
    exec docker run --rm --init --name "agentmill-${run_dir##*/}" --stop-timeout 5 \
        --user "$(id -u):$(id -g)" --cap-drop ALL --security-opt no-new-privileges \
        --mount "type=bind,src=$repo,dst=/workspace" \
        --mount "type=bind,src=$run_dir,dst=/logs" \
        --workdir /workspace --env HOME=/tmp/agentmill-home \
        --env ANTHROPIC_API_KEY --env CLAUDE_CODE_OAUTH_TOKEN --env CHECK_CMD \
        --env AUTO_SETUP --env REPO_SETUP_COMMAND --env EXTRA_PYTHON_TOOLS \
        --env GIT_CONFIG_COUNT=1 --env GIT_CONFIG_KEY_0=safe.directory \
        --env GIT_CONFIG_VALUE_0=/workspace \
        --env GIT_AUTHOR_NAME=AgentMill --env GIT_AUTHOR_EMAIL=agentmill@localhost \
        --env GIT_COMMITTER_NAME=AgentMill --env GIT_COMMITTER_EMAIL=agentmill@localhost \
        --entrypoint python3 "${AGENTMILL_IMAGE:-agentmill}" -I /basic_loop.py \
        --iterations "$iterations" --timeout "$timeout" --model "$model"
}

cmd_init() {
    [[ "${1:-}" != --help && "${1:-}" != -h ]] || usage 0
    [[ $# -le 1 ]] || { echo "Usage: mill init [repo]" >&2; return 1; }
    local repo="${1:-${REPO_PATH:-$PWD}}"
    repo="$(cd "$repo" && pwd -P)" || return 1
    [[ -d "$repo/.git" && ! -L "$repo/.git" ]] || {
        echo "Runs need a regular git checkout (no linked worktrees)." >&2; return 1;
    }
    if [[ -e "$repo/MILL.md" || -L "$repo/MILL.md" ]]; then
        printf 'Keeping existing mission: %s/MILL.md\n' "$repo"
    else
        (set -o noclobber; cat > "$repo/MILL.md" <<'MISSION'
# Mission

Replace this paragraph with one concrete change you want the agent to make.

## Acceptance criteria

- Describe the behavior that must work when the task is complete.
- Name the tests or other checks that demonstrate it.
MISSION
        ) || return 1
        printf 'Created %s/MILL.md\n' "$repo"
    fi
    echo "Edit MILL.md, then commit it and any other checkout changes before running."
    echo "Set ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN in your environment or AgentMill's .env."
    printf "Next: mill run %q --check 'your test command'\n" "$repo"
}

cmd_build() {
    local platform=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --platform) platform="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    if [[ -n "$platform" ]]; then
        DOCKER_DEFAULT_PLATFORM="$platform" docker build -t agentmill "$MILL_DIR"
    else
        docker build -t agentmill "$MILL_DIR"
    fi
}

case "${1:-}" in
    legacy) shift; exec bash "$MILL_DIR/legacy/mill" "$@" ;;
esac
load_env
case "${1:-}" in
    run) shift; cmd_run "$@" ;;
    init) shift; cmd_init "$@" ;;
    build) shift; cmd_build "$@" ;;
    ""|-h|--help|help) usage 0 ;;
    *) echo "Unknown command: $1 (old commands are under 'mill legacy')." >&2; usage 1 ;;
esac
