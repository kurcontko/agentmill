#!/usr/bin/env bash
set -euo pipefail

# mill — run an AI agent (claude or codex) in a respawning loop, inside Docker.

MILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NET="agentmill"
DIND="agentmill-dind"

usage() {
    cat <<'EOF'
mill — AgentMill CLI

Usage:
  mill run   [repo] [--agent claude|codex] [--model M] [--iterations N]
             [--prompt FILE] [--dind] [-d|--detach]
  mill shell [repo] [--dind]     Interactive shell inside the container
  mill logs                      Follow the running loop's output
  mill ps                        List running agentmill containers
  mill build                     Build the container image
  mill stop  [repo]              Stop one checkout's container, or all of them
                                 (the dind sidecar goes when the last one does)
  mill init                      Create .env from .env.example

Config comes from .env (see .env.example); flags override it.
Parallel agents: make a worktree per agent and run mill once per worktree —
  git -C ~/repo worktree add ../repo-b agent-b && mill run ../repo-b -d
EOF
    exit "${1:-0}"
}

require_repo() {
    local repo="${1:-${REPO_PATH:-}}"
    [[ -n "$repo" ]] || { echo "Error: repo path required (pass repo or set REPO_PATH in .env)" >&2; exit 1; }
    [[ "$repo" == /* ]] || repo="$PWD/$repo"
    [[ -e "$repo/.git" ]] || { echo "Error: $repo is not a git repo" >&2; exit 1; }
    REPO_PATH="$repo"
    # Distinct containers/log dirs per checkout: two repos can share a basename,
    # and force-removing the other one's container would kill a live run.
    CONTAINER_NAME="agentmill-$(basename "$REPO_PATH" | tr -c 'a-zA-Z0-9_.-' '-' | sed 's/-$//')-$(path_hash "$REPO_PATH")"
}

path_hash() { printf '%s' "$1" | (shasum 2>/dev/null || cksum) | tr -cd 'a-f0-9' | cut -c1-6; }

# A linked worktree's .git is a file pointing at <main repo>/.git/worktrees/<name>;
# that exact path must exist inside the container too, or git fails on the first
# command. Use the recorded path verbatim — it is what git will dereference.
worktree_mount() {
    [[ -f "$REPO_PATH/.git" ]] || return 0
    local gitdir common entry path
    gitdir="$(sed -n 's/^gitdir: *//p' "$REPO_PATH/.git" | head -1)"
    [[ -n "$gitdir" ]] || { echo "Error: $REPO_PATH/.git has no gitdir: pointer" >&2; exit 1; }
    [[ "$gitdir" == /* ]] || {
        echo "Error: $REPO_PATH records a relative gitdir ($gitdir), which cannot be" >&2
        echo "       mapped into the container. Recreate the worktree with absolute paths." >&2
        exit 1
    }
    common="${gitdir%/worktrees/*}"          # the main repo's git dir
    [[ -d "$common" ]] || { echo "Error: git dir $common not found for worktree $REPO_PATH" >&2; exit 1; }
    RUN_ARGS+=(-v "$common:$common")
    # Each worktrees/<name>/gitdir records the host path of that checkout's
    # .git file. `git worktree prune` (also run by gc) deletes any entry whose
    # path does not exist — inside the container none of them would, so one
    # prune would wreck this worktree and every sibling's on the host. Make
    # every recorded path resolve by mounting the .git file itself, read-only.
    for entry in "$common"/worktrees/*/gitdir; do
        [[ -f "$entry" ]] || continue
        path="$(head -1 "$entry")"
        [[ "$path" == /* && -f "$path" ]] || continue
        RUN_ARGS+=(-v "$path:$path:ro")
    done
}

# Config the container understands. .env keys are appended by load_env, so a
# custom var set there reaches the agent too.
ENV_KEYS=(ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN OPENAI_API_KEY
          AGENT MODEL FALLBACK_MODEL MAX_ITERATIONS MAX_ERRORS MAX_NOOPS
          ITER_TIMEOUT LOOP_DELAY ERROR_BACKOFF MAX_BACKOFF SHUTDOWN_GRACE
          DONE_PROMISE SETUP_CMD CHECK_CMD GIT_USER GIT_EMAIL)
ENV_FILE_KEYS=() ENV_FILE_VALS=()   # parallel arrays: bash 3 has no assoc arrays

# Resolved config value: the caller's environment wins over .env, so
# `ANTHROPIC_API_KEY=... ./mill run repo` overrides the file.
cfg() {
    local i
    if [[ -n "${!1:-}" ]]; then printf '%s' "${!1}"; return; fi
    for i in ${ENV_FILE_KEYS[@]+"${!ENV_FILE_KEYS[@]}"}; do
        [[ "${ENV_FILE_KEYS[$i]}" == "$1" ]] && { printf '%s' "${ENV_FILE_VALS[$i]}"; return 0; }
    done
    return 0
}

# .env is KEY=value. Values may be "double" or 'single' quoted; unquoted
# values end at an inline ` # comment` and lose surrounding whitespace.
# Parsed into ENV_FILE_*, never exported: a PATH= or DOCKER_HOST= line must
# not redirect mill's own commands.
load_env() {
    [[ -f "$MILL_DIR/.env" ]] || return 0
    local line key val k seen
    while IFS= read -r line || [[ -n "$line" ]]; do   # || : last line may lack a newline
        [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=(.*)$ ]] || continue
        key="${BASH_REMATCH[2]}" val="${BASH_REMATCH[3]}"
        val="${val#"${val%%[![:space:]]*}"}"                       # ltrim
        if [[ "$val" =~ ^\"(([^\"\\]|\\.)*)\"[[:space:]]*(#.*)?$ ]]; then
            val="${BASH_REMATCH[1]}"; val="${val//\\\"/\"}"; val="${val//\\\\/\\}"
        elif [[ "$val" =~ ^\'([^\']*)\'[[:space:]]*(#.*)?$ ]]; then
            val="${BASH_REMATCH[1]}"
        else
            [[ "$val" == \#* ]] && val=""
            val="${val%%[[:space:]]#*}"                            # inline comment
            val="${val%"${val##*[![:space:]]}"}"                   # rtrim
        fi
        ENV_FILE_KEYS+=("$key") ENV_FILE_VALS+=("$val")
        case "$key" in PATH|HOME|REPO_PATH|AGENTMILL_IMAGE) continue ;; esac   # mill-only / host-only
        seen=false
        for k in "${ENV_KEYS[@]}"; do [[ "$k" == "$key" ]] && { seen=true; break; }; done
        [[ "$seen" == true ]] || ENV_KEYS+=("$key")
    done < "$MILL_DIR/.env"
}

# DinD sidecar for repos whose work needs docker (testcontainers, image
# builds). Privileged, but the blast radius is the sidecar — never the host
# docker socket.
ensure_dind() {
    docker network inspect "$NET" >/dev/null 2>&1 || docker network create "$NET" >/dev/null
    docker container inspect "$DIND" >/dev/null 2>&1 || {
        echo "Starting dind sidecar..."
        docker run -d --rm --name "$DIND" --label agentmill --label agentmill.dind --privileged \
            --network "$NET" -e DOCKER_TLS_CERTDIR= docker:27-dind >/dev/null
    }
    DIND_ARGS=(--network "$NET" -e "DOCKER_HOST=tcp://$DIND:2375")
}

common_args() {  # fills RUN_ARGS with env + mounts shared by run/shell
    RUN_ARGS=(--label agentmill --init --memory 4g --pids-limit 512)
    # Forwarded explicitly (not --env-file) so values resolved from the caller's
    # environment reach the container too; docker inherits nothing by itself.
    local key val
    for key in "${ENV_KEYS[@]}"; do
        val="$(cfg "$key")"
        [[ -n "$val" ]] && RUN_ARGS+=(-e "$key=$val")
    done
    LOG_DIR_HOST="$MILL_DIR/logs/$CONTAINER_NAME"   # per checkout: parallel runs must not interleave
    mkdir -p "$LOG_DIR_HOST" "$MILL_DIR/prompts"
    RUN_ARGS+=(
        -v "$REPO_PATH:/workspace/repo"
        -v "$LOG_DIR_HOST:/workspace/logs"
        -v "$MILL_DIR/prompts:/prompts:ro"
    )
    worktree_mount
}

cmd_run() {
    local repo="" agent="" model="" iterations="" prompt="" detach=false dind=false
    [[ $# -gt 0 && "${1:0:1}" != "-" ]] && { repo="$1"; shift; }
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)     usage 0 ;;
            --agent)       agent="$2"; shift 2 ;;
            --model)       model="$2"; shift 2 ;;
            --iterations)  iterations="$2"; shift 2 ;;
            --prompt)      prompt="$2"; shift 2 ;;
            --dind)        dind=true; shift ;;
            -d|--detach)   detach=true; shift ;;
            -*) echo "Error: unknown option: $1" >&2; usage 1 ;;
            *) [[ -z "$repo" ]] || { echo "Error: unexpected argument: $1" >&2; usage 1; }
               repo="$1"; shift ;;
        esac
    done
    require_repo "$repo"

    common_args
    [[ -n "$agent" ]]      && RUN_ARGS+=(-e "AGENT=$agent")
    [[ -n "$model" ]]      && RUN_ARGS+=(-e "MODEL=$model")
    [[ -n "$iterations" ]] && RUN_ARGS+=(-e "MAX_ITERATIONS=$iterations")
    if [[ -n "$prompt" ]]; then
        [[ "$prompt" == /* ]] || prompt="$PWD/$prompt"
        [[ -f "$prompt" ]] || { echo "Error: prompt file not found: $prompt" >&2; exit 1; }
        RUN_ARGS+=(-v "$prompt:/prompts/PROMPT.md:ro")
    fi
    [[ "$dind" == true ]] && { ensure_dind; RUN_ARGS+=("${DIND_ARGS[@]}"); }
    [[ "$detach" == true ]] && RUN_ARGS+=(-d)

    if docker ps -q --filter "name=^/${CONTAINER_NAME}$" | grep -q .; then
        echo "Error: $CONTAINER_NAME is already running for $REPO_PATH (mill stop, or wait)" >&2
        exit 1
    fi
    docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
    docker run --rm --name "$CONTAINER_NAME" "${RUN_ARGS[@]}" "$IMAGE"
}

cmd_shell() {
    local repo="" dind=false
    [[ $# -gt 0 && "${1:0:1}" != "-" ]] && { repo="$1"; shift; }
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) usage 0 ;;
            --dind) dind=true; shift ;;
            -*) echo "Error: unknown option: $1" >&2; usage 1 ;;
            *) [[ -z "$repo" ]] || { echo "Error: unexpected argument: $1" >&2; usage 1; }
               repo="$1"; shift ;;
        esac
    done
    require_repo "$repo"
    common_args
    [[ "$dind" == true ]] && { ensure_dind; RUN_ARGS+=("${DIND_ARGS[@]}"); }
    docker run --rm -it --entrypoint bash "${RUN_ARGS[@]}" -w /workspace/repo "$IMAGE"
}

cmd_logs() {
    local c
    c="$(docker ps -q --filter label=agentmill --filter ancestor="$IMAGE" | head -1)"
    if [[ -n "$c" ]]; then
        docker logs -f "$c"
    else
        # Collect first: with no matches, `xargs ls -t` would list the cwd.
        local latest files=() f
        while IFS= read -r f; do files+=("$f"); done < <(
            find "$MILL_DIR/logs" -maxdepth 2 -name 'iter-*.log' 2>/dev/null)
        [[ ${#files[@]} -gt 0 ]] || { echo "No running container and no logs." >&2; exit 1; }
        # shellcheck disable=SC2012  # names are generated by loop.sh, no spaces
        latest="$(ls -t "${files[@]}" | head -1)"
        echo "=== $(basename "$latest") ==="
        tail -f "$latest"
    fi
}

cmd_ps()    { docker ps --filter label=agentmill; }

# The container user must own the bind-mounted repo and logs. Docker Desktop
# maps ownership for you; on a Linux host the uids have to match for real.
cmd_build() {
    local args=()
    [[ "$(uname -s)" == Linux ]] && args=(--build-arg "AGENT_UID=$(id -u)" --build-arg "AGENT_GID=$(id -g)")
    docker build ${args[@]+"${args[@]}"} -t "$IMAGE" "$MILL_DIR"
}

# With a repo: stop that checkout only, so parallel worktree runs survive
# each other's stops. The shared dind sidecar and network go when the last
# agent container is gone. Without a repo: everything.
cmd_stop() {
    local ids
    if [[ $# -gt 0 ]]; then
        require_repo "$1"
        docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
        ids="$(docker ps -aq --filter label=agentmill | grep -v -x -F "$(docker ps -aq --filter label=agentmill.dind)" || true)"
        [[ -z "$ids" ]] || { echo "Stopped $CONTAINER_NAME."; return 0; }
    fi
    ids="$(docker ps -aq --filter label=agentmill)"
    [[ -n "$ids" ]] && echo "$ids" | xargs docker rm -f >/dev/null
    docker network rm "$NET" >/dev/null 2>&1 || true
    echo "Stopped."
}

cmd_init() {
    if [[ -f "$MILL_DIR/.env" ]]; then
        echo ".env already exists."
    else
        cp "$MILL_DIR/.env.example" "$MILL_DIR/.env"
        echo "Created .env — set your auth key and REPO_PATH."
    fi
}

load_env
IMAGE="$(cfg AGENTMILL_IMAGE)"; IMAGE="${IMAGE:-agentmill}"
case "${1:-}" in
    run)    shift; cmd_run "$@" ;;
    shell)  shift; cmd_shell "$@" ;;
    logs)   shift; cmd_logs "$@" ;;
    ps)     shift; cmd_ps "$@" ;;
    build)  shift; cmd_build "$@" ;;
    stop)   shift; cmd_stop "$@" ;;
    init)   shift; cmd_init "$@" ;;
    -h|--help|help|"") usage 0 ;;
    *) echo "Unknown command: $1" >&2; usage 1 ;;
esac
