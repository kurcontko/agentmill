# KEY=value per line. Values may be quoted; unquoted values end at an
# inline ` # comment`. The caller's environment overrides this file.
# Precedence: flags > environment > MILL.md frontmatter > this file.
# Interpreter/loader startup controls (BASH_ENV, ENV, LD_*, DYLD_*,
# GCONV_PATH, LOCPATH, NLSPATH, TAR_OPTIONS) are refused in config/frontmatter.

# --- auth — set what your agent needs ---------------------------------------
# claude: ANTHROPIC_API_KEY, or CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`
# codex:  OPENAI_API_KEY
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=

# --- agent ------------------------------------------------------------------
# claude | codex
AGENT=claude
# leave empty to let each CLI pick its own default (codex has no `sonnet`)
MODEL=
# claude only: model to fall back to when MODEL is overloaded (empty = none)
FALLBACK_MODEL=
# claude only: true adds --bare, which skips CLAUDE.md and hook discovery
CLAUDE_BARE=false

# --- stop conditions --------------------------------------------------------
# 0 = unbounded
MAX_ITERATIONS=0
# consecutive agent failures before giving up (exponential backoff between,
# ERROR_BACKOFF * 2^n seconds, capped at MAX_BACKOFF); 0 = unbounded
MAX_ERRORS=3
ERROR_BACKOFF=30
MAX_BACKOFF=900
# consecutive no-progress iterations before stopping (0 = unbounded); a
# reverted or self-reported `blocked` session counts as no progress
MAX_NOOPS=3
# seconds per agent session and per CHECK_CMD/DONE_CMD/METRIC_CMD invocation
# (including the baseline) / between iterations; timed-out or signalled agents
# receive SIGKILL after SHUTDOWN_GRACE
ITER_TIMEOUT=3600
# Separate phase limits; blank agent/check values inherit ITER_TIMEOUT.
SETUP_TIMEOUT=900
AGENT_TIMEOUT=
CHECK_TIMEOUT=
# Total run time, including setup and backoff; cleanup may add a bounded grace.
# Set 0 explicitly for an unbounded run duration.
MAX_DURATION=3600
SHUTDOWN_GRACE=30
LOOP_DELAY=5
# a session that ends in fewer turns without touching the repo counts as an
# error, not a no-op — usually a bad key or model (0 = off)
MIN_TURNS=2
# fallback completion signal: used only when the agent CLI returned no
# structured reply (normally the agent answers `done: true` instead)
DONE_PROMISE=TASK_COMPLETE

# --- budgets ----------------------------------------------------------------
# claude only: cap the turns and the spend of one session (0 / empty = no cap)
MAX_TURNS=0
MAX_BUDGET_USD=
# Claude: remaining allowance clamps every worker and reviewer invocation.
# Unknown cost blocks subsequent paid sessions when this is set. Codex monetary
# limits are unsupported; use MAX_ITERATIONS and MAX_DURATION instead.
# Enforcement of the per-session dollar limit depends on the provider CLI.
MAX_TOTAL_BUDGET_USD=
# Reserved from the total allowance for review when EVALUATOR=true.
REVIEW_RESERVE_USD=0.50

# --- ratchet & completion ---------------------------------------------------
# Runs once as the unprivileged worker, e.g.: uv sync. System packages must
# already be installed in the operator's derived image (AGENTMILL_IMAGE).
SETUP_CMD=
# Ratchet: runs after each iteration; failure reverts it, e.g.: python3 -m pytest -q
CHECK_CMD=
# Note: a revert discards the worktree, so the loop refuses to start on a repo
# with uncommitted changes — commit or stash them first.
# Completion verifier: a "done" claim is rejected (and logged into PROGRESS.md)
# if this fails. Empty falls back to requiring CHECK_CMD green on that iteration.
DONE_CMD=
# true = one reviewer in a writable disposable snapshot must PASS before a done
# claim stops the loop; NEEDS_WORK findings go into PROGRESS.md and its snapshot
# (including verifier artifacts) is discarded afterward. Requires Linux
# Landlock ABI 3+ on linux/amd64 or linux/arm64; unsupported/blocked systems
# reject the review rather than running it without isolation. Metadata-changing
# and process-injection syscalls plus filesystem-specific ioctl requests are
# unavailable inside the reviewer snapshot. Repository-authored instructions,
# config, rules, hooks, and skills are off; incomplete skill discovery rejects
# evaluator setup.
EVALUATOR=false

# --- metric mode ------------------------------------------------------------
# Metric ratchet: prints a score; the last line of its stdout is the number
# (empty = off, e.g.: python3 bench.py). Measured once before the loop for a
# baseline, then after each iteration; only a strict improvement is kept.
# A successful initializer creating PROGRESS.md may keep an unchanged score.
METRIC_CMD=
# min | max — which direction of METRIC_CMD's number counts as better
METRIC_DIRECTION=min

# --- git identity of the loop's commits -------------------------------------
GIT_USER=agentmill
GIT_EMAIL=agent@agentmill

# --- mill only (host side) --------------------------------------------------
# `mill --dind` fails closed if the sidecar's TCP endpoint is not ready by then.
DIND_READY_TIMEOUT=30
# image name for `mill build` / `mill run`
AGENTMILL_IMAGE=agentmill
# The container paths PROMPT_FILE, EVALUATOR_FILE, MISSION_FILE, REPO_DIR and
# LOG_DIR are set by mill; override them only when running loop.sh by hand.

# Operator steering, in the checkout's .mill/ (git-excluded automatically):
#   mill stop --soft   drops .mill/STOP, so the loop finishes the current
#                      iteration and stops instead of being killed mid-session
#   mill steer "..."   drops .mill/STEER.md, a one-shot instruction injected
#                      into the next session's prompt and then consumed
