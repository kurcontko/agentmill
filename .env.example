# KEY=value per line. Values may be quoted; unquoted values end at an
# inline ` # comment`. The caller's environment overrides this file.

# Auth — set what your agent needs.
# claude: ANTHROPIC_API_KEY, or CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`
# codex:  OPENAI_API_KEY
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=


# claude | codex
AGENT=claude
# leave empty to let each CLI pick its own default (codex has no `sonnet`)
MODEL=
# claude only: model to fall back to when MODEL is overloaded (empty = none)
FALLBACK_MODEL=

# 0 = unbounded (for all three)
MAX_ITERATIONS=0
# consecutive agent failures before giving up (exponential backoff between,
# ERROR_BACKOFF * 2^n seconds, capped at MAX_BACKOFF)
MAX_ERRORS=3
ERROR_BACKOFF=30
MAX_BACKOFF=900
# consecutive no-progress iterations before stopping
MAX_NOOPS=3
# seconds per iteration / between iterations; timed-out or signalled agents
# receive SIGKILL after SHUTDOWN_GRACE
ITER_TIMEOUT=3600
SHUTDOWN_GRACE=30
LOOP_DELAY=5
# loop stops when the agent's final message contains this
DONE_PROMISE=TASK_COMPLETE

# claude only: cap the turns and the spend of one session (0 / empty = no cap)
MAX_TURNS=0
MAX_BUDGET_USD=
# loop-wide spend cap in USD; the loop stops once the summed cost reaches it
MAX_TOTAL_BUDGET_USD=
# a session that ends in fewer turns without touching the repo counts as an
# error, not a no-op (0 = off)
MIN_TURNS=2

# Runs once before the loop, e.g.: curl -LsSf https://astral.sh/uv/install.sh | sh && uv sync
SETUP_CMD=
# Ratchet: runs after each iteration; failure reverts it, e.g.: python3 -m pytest -q
CHECK_CMD=
# Note: a revert discards the worktree, so the loop refuses to start on a repo
# with uncommitted changes — commit or stash them first.

GIT_USER=agentmill
GIT_EMAIL=agent@agentmill

# `mill --dind` fails closed if the sidecar's TCP endpoint is not ready by then.
DIND_READY_TIMEOUT=30
